{
	"name": "smoqe-web",
	// Keep a few weeks behind today: Pages rejects deploys whose compat date
	// is newer than the runtime it has rolled out (broke the 2026-07-13 value).
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"vars": {
		"PUBLIC_SITE_URL": "https://smoqesignals.com"
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.05 }
	}
}
