# ── smoqe-web (SvelteKit / Cloudflare) ───────────────────────────
# Base URL of the Payload CMS backend (your VPS).
# Server-side only — used by load functions and form actions.
PAYLOAD_API_URL="http://localhost:3000"

# Must exactly match STOREFRONT_API_KEY on the Payload backend.
STOREFRONT_API_KEY="change-me-to-another-long-random-string"

# Public site URL (used for canonical links, SEO, sitemap).
PUBLIC_SITE_URL="http://localhost:5173"
