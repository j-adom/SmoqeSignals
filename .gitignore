# WSL "mark of the web" download artifacts
# (match both a literal ":" and WSL's U+F03A stand-in for the NTFS stream colon)
*Zone.Identifier

# OS
.DS_Store
Thumbs.db

# Env / secrets (subdirectories also ignore these)
.env
.env.*
!.env.example

# Dependencies / build output (belt-and-suspenders; subdirs also ignore)
node_modules/
.svelte-kit/
.next/
/build
/dist
.wrangler/
