# ── smoqe-load (Payload CMS · Next.js) ───────────────────────────

# Database. SQLite locally (default below), PostgreSQL in production.
DATABASE_URI="file:./smoqe.db"
# Production example:
# DATABASE_URI="postgres://user:pass@host:5432/smoqe"

# Long random string. REQUIRED in production.
PAYLOAD_SECRET="change-me-to-a-long-random-string"

# Public URL this backend is served from (your VPS).
PAYLOAD_PUBLIC_SERVER_URL="http://localhost:3000"

# The storefront origin (used for CORS + Stripe redirect URLs).
FRONTEND_URL="http://localhost:5173"

# ── Stripe (rub shop checkout) ───────────────────────────────────
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Shipping / tax (cents + rate)
FREE_SHIPPING_THRESHOLD="4500"      # free shipping at/above $45.00
FLAT_SHIPPING_RATE="650"            # $6.50 flat otherwise
TENNESSEE_STATE_TAX_RATE="0.0925"   # applied to TN ship-to addresses

# ── Email (transactional notifications) — SMTP ───────────────────
SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="orders@smoqesignals.com"
FROM_NAME="Smoqe Signals BBQ"
STAFF_NOTIFICATION_EMAIL="info@smoqesignals.com"

# ── Cloudflare R2 image storage (optional) ───────────────────────
# Leave blank to store uploads on local disk during development.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="smoqe-signals"
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
